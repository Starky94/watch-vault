{
  "name": "watchvault",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@12.2.0",
  "engines": {
    "node": "^24.15.0 || ^26.0.0",
    "npm": "^12.2.0"
  },
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "server:watch": "node --watch server/index.js",
    "build": "npm run typecheck && vite build",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "import:movies": "node server/importMoviesCli.js",
    "import:books": "node server/importBooksCli.js",
    "import:entertainment-news": "node server/importEntertainmentNewsCli.js",
    "import:now-playing": "node server/importNowPlayingCli.js",
    "import:upcoming": "node server/importUpcomingCli.js",
    "import:movie-keywords": "node server/importMovieKeywordsCli.js",
    "import:tv-popular": "node server/importPopularTvShowsCli.js",
    "import:tv-airing-today": "node server/importAiringTodayTvShowsCli.js",
    "import:tv-on-the-air": "node server/importOnTheAirTvShowsCli.js",
    "import:games": "node server/importGamesCli.js",
    "import:games-recently-released": "node server/importRecentlyReleasedGamesCli.js",
    "import:games-upcoming": "node server/importUpcomingGamesCli.js",
    "dispatch:alerts": "node server/dispatchAlertsCli.js",
    "schedule:themes": "node server/themeSchedulerWorker.js",
    "schedule:themes:once": "node server/themeSchedulerCli.js",
    "schedule:news-cleanup": "node server/newsCleanupWorker.js",
    "backfill:movie-credits": "node server/backfillMovieCreditsCli.js",
    "dev:stack": "node scripts/dev-stack.js",
    "deploy:prod-8181": "bash scripts/deploy-production-8181.sh",
    "test": "node --test",
    "import:collections": "node server/importCollectionsCli.js",
    "schedule:collections": "node server/collectionImportWorker.js",
    "sync:trending-videos": "node server/trendingVideoWorker.js --once",
    "schedule:trending-videos": "node server/trendingVideoWorker.js"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  }
}
